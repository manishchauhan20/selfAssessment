# Copy this file to ".env" and fill in your values.
GEMINI_API_KEY=your_api_key_here
GEMINI_MODEL=gemini-2.5-flash
JWT_SECRET=your_jwt_secret_here
ADMIN_DEFAULT_EMAIL=cm80818087@gmail.com
ADMIN_DEFAULT_PASSWORD=123456
# Local MongoDB example:
# MONGODB_URI=mongodb://127.0.0.1:27017/self_assessment
# Atlas example:
# MONGODB_URI=mongodb+srv://<username>:<password>@<cluster-url>/<dbName>?retryWrites=true&w=majority
MONGODB_URI=your_mongodb_connection_string_here
MONGODB_DB_NAME=SelfAssessments
PORT=5000
FRONTEND_BASE_URL=http://localhost:3000
BASE_URL=http://localhost:5000
DEFAULT_FREE_EXAM_LIMIT=6
BOOK_UPLOAD_MAX_FILE_SIZE_MB=80
BOOK_UPLOAD_MAX_FILES=10
PHONEPE_MODE=uat
PHONEPE_CLIENT_ID=your_phonepe_client_id
PHONEPE_CLIENT_SECRET=your_phonepe_client_secret

# Gmail option (recommended for quick setup)
EMAIL_USER=your_gmail@gmail.com
APP_PASSWORD=your_16_digit_gmail_app_password

# SMTP option (for custom providers)
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=your_email@example.com
# SMTP_PASS=your_smtp_password
# SMTP_FROM=your_email@example.com
# SMTP_SECURE=false
